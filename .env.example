# Copy to .env and fill in. Keep .env private: it holds the admin password.

# The domain bonestats is served on. Its DNS must point at this server.
BONESTATS_DOMAIN=stats.example.com

# Admin password, at least 12 characters.
BONESTATS_PASSWORD=

# Timezone for dashboard days, e.g. Europe/Berlin.
BONESTATS_TZ=UTC

# Delete data older than this many days (0 = keep forever).
BONESTATS_RETENTION_DAYS=365

# Image tag to run, e.g. 1.2.0 to stay on one release. latest follows new releases.
BONESTATS_VERSION=latest
